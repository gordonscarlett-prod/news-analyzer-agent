# Install: sudo cp deploy/news-analyzer-backend.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now news-analyzer-backend
#
# Keeps the FastAPI backend (and its APScheduler daily job) running
# continuously — starts on boot, restarts on crash, no terminal needed.

[Unit]
Description=News Analyzer Agent backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/news-analyzer/backend
ExecStart=/opt/news-analyzer/backend/venv/bin/python main.py
EnvironmentFile=/opt/news-analyzer/.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
