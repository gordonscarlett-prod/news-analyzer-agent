# Anthropic API (used for article sector/impact scoring and daily narrative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Finnhub — free tier: 60 calls/min, sign up at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# NewsAPI.org — free "Developer" tier: 1000 req/day, personal/non-production use,
# sign up at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# App Config
DATABASE_URL=sqlite:///./news_analyzer.db
