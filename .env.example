# Anthropic API (used for article sector/impact scoring and daily narrative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Finnhub — free tier: 60 calls/min, sign up at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# NewsAPI.org — free "Developer" tier: 1000 req/day, personal/non-production use,
# sign up at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Marketaux — free tier: 100 req/day, entity-tagged news with sentiment,
# sign up at https://www.marketaux.com/
MARKETAUX_API_KEY=your_marketaux_api_key_here

# FRED (Federal Reserve Bank of St. Louis) — free, no rate-limit concerns for this volume,
# sign up at https://fred.stlouisfed.org/docs/api/api_key.html
FRBSL_API_KEY=your_fred_api_key_here

# App Config
DATABASE_URL=sqlite:///./news_analyzer.db
